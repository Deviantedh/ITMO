    {
      "id": "aqiFntcx2Tcoh8GxKKnd8",
      "type": "text",
      "x": 10973.79438905589,
      "y": 4384.777189687843,
      "width": 1518.75,
      "height": 475.19999999999993,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1991250634,
      "version": 1315,
      "versionNonce": 832187786,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1705969450770,
      "link": null,
      "locked": false,
      "text": "1024 / 209 = 4,9 = 4 - записи на сектор\n4 * 209 = 836 полезных байт в секторе\n1024 - (209 * 4) = 188 - фрагментация в одном секторе\nТак как интересует только фрагментация, плевать на дорожки и поверхности\n\n57358 / 4 = 14339,5 = 14339 заполнены со стандартной фрагментацией\n57358 * 209 - 14339 * 836 = 418 байт надо заполнить на последнем секторе\n1024 - 418 = 606 остаток по последнему сектору\n\nитого сфрагментировано:\n",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 465,
      "containerId": null,
      "originalText": "1024 / 209 = 4,9 = 4 - записи на сектор\n4 * 209 = 836 полезных байт в секторе\n1024 - (209 * 4) = 188 - фрагментация в одном секторе\nТак как интересует только фрагментация, плевать на дорожки и поверхности\n\n57358 / 4 = 14339,5 = 14339 заполнены со стандартной фрагментацией\n57358 * 209 - 14339 * 836 = 418 байт надо заполнить на последнем секторе\n1024 - 418 = 606 остаток по последнему сектору\n\nитого сфрагментировано:\n",
      "lineHeight": 1.2
    },
